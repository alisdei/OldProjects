<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <configSections>
    </configSections>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5" />
    </startup>
    <system.serviceModel>
        <bindings>
            <wsHttpBinding>
                <binding name="WSHttpBinding_IServicio" />
            </wsHttpBinding>
        </bindings>
        <client>
            <endpoint address="http://localhost:8000/SiiaService" binding="wsHttpBinding"
                bindingConfiguration="WSHttpBinding_IServicio" contract="WCFServicio.IServicio"
                name="WSHttpBinding_IServicio">
                <identity>
                    <servicePrincipalName value="host/Valenzuela-PC" />
                </identity>
            </endpoint>
        </client>
    </system.serviceModel>
</configuration>