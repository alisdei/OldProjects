@model IEnumerable<MvSVG.Models.Producto>

@{
    ViewBag.Title = "Index";
}

<h2>Inicio</h2>

<p>
    @Html.ActionLink("Nuevo Registro", "Create")
</p>
<table>
    <tr>
        <th style="padding-right:20px;">
            @Html.DisplayNameFor(model => model.Codigo)
        </th>
        <th style="padding-right:20px;">
            @Html.DisplayNameFor(model => model.Descripcion)
        </th>
        <th style="padding-right:20px;">
            @Html.DisplayNameFor(model => model.Valvula.Descripcion)
        </th>
        <th style="padding-right:20px;">
            @Html.DisplayNameFor(model => model.Peso)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td style="padding-right:20px;">
            @Html.DisplayFor(modelItem => item.Codigo)
        </td>
        <td style="padding-right:20px;">
            @Html.DisplayFor(modelItem => item.Descripcion)
        </td>
        <td style="padding-right:20px;">
            @Html.DisplayFor(modelItem => item.Valvula.Descripcion)
        </td>
        <td style="padding-right:20px;">
            @Html.DisplayFor(modelItem => item.Peso)
        </td>
        <td style="padding-right:20px;">
            @Html.ActionLink("Editar", "Edit", new { id=item.ProductoID }) |
            @Html.ActionLink("Detalles", "Details", new { id=item.ProductoID }) |
            @Html.ActionLink("Eliminar", "Delete", new { id=item.ProductoID })
        </td>
    </tr>
}

</table>
