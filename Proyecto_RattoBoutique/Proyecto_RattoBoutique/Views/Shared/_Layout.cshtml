<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <title>@ViewBag.Title - My ASP.NET MVC Application</title>
        <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />
        <meta content="IE=edge,chrome=1" http-equiv="X-UA-Compatible">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="description" content="">
        <meta name="author" content="">

        @Styles.Render("~/lib/bootstrap/css/css")
        @Styles.Render("~/stylesheets/css")
        @Styles.Render("~/lib/font-awesome/css/css")
        @Scripts.Render("~/bundles/jqueryuis")
        
        <script src="lib/jquery-1.7.2.min.js" type="text/javascript"></script>
       <style type="text/css">
        #line-chart {
            height:300px;
            width:800px;
            margin: 0px auto;
            margin-top: 1em;
        }
        .brand { font-family: georgia, serif; }
        .brand .first {
            color: #ccc;
            font-style: italic;
        }
        .brand .second {
            color: #fff;
            font-weight: bold;
        }
    </style>
          <!-- Le HTML5 shim, for IE6-8 support of HTML5 elements -->
    <!--[if lt IE 9]>
      <script src="http://html5shim.googlecode.com/svn/trunk/html5.js"></script>
    <![endif]-->

    <!-- Le fav and touch icons -->
    <link rel="shortcut icon" href="../assets/ico/favicon.ico">
    <link rel="apple-touch-icon-precomposed" sizes="144x144" href="../assets/ico/apple-touch-icon-144-precomposed.png">
    <link rel="apple-touch-icon-precomposed" sizes="114x114" href="../assets/ico/apple-touch-icon-114-precomposed.png">
    <link rel="apple-touch-icon-precomposed" sizes="72x72" href="../assets/ico/apple-touch-icon-72-precomposed.png">
    <link rel="apple-touch-icon-precomposed" href="../assets/ico/apple-touch-icon-57-precomposed.png">
    </head>
    <body>
         <div class="navbar">
        <div class="navbar-inner">
                <ul class="nav pull-right">
                    
                    <li><a href="#" class="hidden-phone visible-tablet visible-desktop" role="button">Settings</a></li>
                    <li id="fat-menu" class="dropdown">
                        <a href="#" role="button" class="dropdown-toggle" data-toggle="dropdown">
                            <i class="icon-user"></i> @Session["NombreUsuario"]
                            <i class="icon-caret-down"></i>
                        </a>

                        <ul class="dropdown-menu">
                            <li><a tabindex="-1" href="#">My Account</a></li>
                            <li class="divider"></li>
                            <li><a tabindex="-1" class="visible-phone" href="#">Settings</a></li>
                            <li class="divider visible-phone"></li>
                            <li>
                                <a tabindex="-1" href="sign-in.html">
                                @using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <a href="javascript:document.getElementById('logoutForm').submit()">Cerrar sesión</a>
                                }
                                </a>
                            </li>
                        </ul>
                    </li>
                    
                </ul>
                <a class="brand" href="index.html"><span class="first"><img src="@Url.Content("~/Images/logoRatto.png")" style="width:186px;height:40px;" /></a>
        </div>
    </div>

        <div class="sidebar-nav">
        <form class="search form-inline">
            <input type="text" placeholder="Search...">
        </form>

        <a href="#dashboard-menu" class="nav-header" data-toggle="collapse"><i class="icon-dashboard"></i>Caja<span class="label label-info">+2</span></a>
        <ul id="dashboard-menu" class="nav nav-list collapse in">
            <li><a href="index.html">Apertura de Caja</a></li>
            <li ><a href="users.html">Cierre de Caja</a></li>

            
        </ul>

        <a href="#accounts-menu" class="nav-header" data-toggle="collapse"><i class="icon-briefcase"></i>Mantenimientos<span class="label label-info">+2</span></a>
        <ul id="accounts-menu" class="nav nav-list collapse">
            <li ><a href="sign-in.html">TipoDocumento</a></li>
            <li ><a href="sign-up.html">TipoEmpresa</a></li>
        </ul>

        <a href="#error-menu" class="nav-header collapsed" data-toggle="collapse"><i class="icon-exclamation-sign"></i>Catalogo<span class="label label-info">+4</span></a>
        <ul id="error-menu" class="nav nav-list collapse">
            <li ><a href="403.html">Categoria</a></li>
            <li ><a href="404.html">Productos</a></li>
            <li ><a href="500.html">Talla</a></li>
            <li ><a href="503.html">TipoTalla</a></li>
        </ul>

        <a href="#legal-menu" class="nav-header" data-toggle="collapse"><i class="icon-legal"></i>Movimientos<span class="label label-info">+2</span></a>
        <ul id="legal-menu" class="nav nav-list collapse">
            <li ><a href="privacy-policy.html">Ingresos</a></li>
            <li ><a href="terms-and-conditions.html">Salidas</a></li>
        </ul>

        <a href="#Cliente-menu" class="nav-header" data-toggle="collapse"><i class="icon-legal"></i>Clientes<span class="label label-info">+2</span></a>
            <ul id="Cliente-menu" class="nav nav-list collapse">
                <li><a href="Cliente-policy.html">Cliente</a></li>
                <li><a href="Cliente-and-conditions.html">Tipo Clientes</a></li>
            </ul>
    </div>

        <div class="content">
        
        <div class="header">
            <div class="stats">
    <p class="stat"><span class="number">53</span>tickets</p>
    <p class="stat"><span class="number">27</span>tasks</p>
    <p class="stat"><span class="number">15</span>waiting</p>
</div>

            <h1 class="page-title">@Session["MenuOpcion"]</h1>
        </div>
        
                <ul class="breadcrumb">
            <li><a href="index.html">Home</a> <span class="divider">/</span></li>
            <li class="active">@Session["MenuOpcion"]</li>
        </ul>

        <div class="container-fluid">
            <div class="row-fluid">
            @RenderSection("featured", required: false)
            <section class="content-wrapper main-content clear-fix">
                @RenderBody()
            </section>
                <footer>
                        <hr>
                        <!-- Purchase a site license to remove this link from the footer: http://www.portnine.com/bootstrap-themes -->
                        <p class="pull-right">A <a href="http://www.portnine.com/bootstrap-themes" target="_blank">Ratto Boutique</a> v <a href="http://www.portnine.com" target="_blank">1.0.</a></p>
                        

                        <p>&copy; 2012 <a href="http://www.crevexsac.com" target="_blank">Crevex</a></p>
                    </footer>
            </div>
       </div>
    </div>
    

         @Scripts.Render("~/bundles/lib")
        @RenderSection("scripts", required: false)
        <script type="text/javascript">
            $("[rel=tooltip]").tooltip();
            $(function () {
                $('.demo-cancel-click').click(function () { return false; });
            });
    </script>
    </body>
</html>
